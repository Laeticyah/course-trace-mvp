# =============================================================
#  课脉 · Canvas 配置（示例模板 — 复制为 .env 后填写）
# =============================================================
# Canvas 实例根地址（不要带 /api/v1）
CANVAS_BASE_URL=https://oc.sjtu.edu.cn

# Canvas Access Token（用户设置 → 批准集成 → 新访问令牌）
# 令牌视为密码，切勿提交到仓库；没有有效 Token 时同步任务会明确失败
CANVAS_TOKEN=paste_your_6810~token_here

# 自动同步周期（毫秒）；默认每天 03:00，设为 0 关闭
# AUTO_SYNC_INTERVAL_MS=86400000
